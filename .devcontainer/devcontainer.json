{
  "name": "Puestico",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "onCreateCommand": "cd web && npm install",
  "postAttachCommand": "cd web && npm run dev",
  "forwardPorts": [3100],
  "portsAttributes": {
    "3100": {
      "label": "Puestico",
      "onAutoForward": "openPreview",
      "requireLocalPort": false
    }
  },
  "waitFor": "onCreateCommand"
}
