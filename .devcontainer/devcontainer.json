{
  "name": "Puestico",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "cd web && npm install",
  "postAttachCommand": {
    "web": "cd web && npm run dev"
  },
  "forwardPorts": [3100],
  "portsAttributes": {
    "3100": {
      "label": "Puestico — App",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
