# Variables de la aplicación web de Puestico.
# Copiar a .env.local para desarrollo. Ninguna es obligatoria: sin
# archivo, la app arranca en modo demo.

# ─── Acceso rápido — TEMPORAL ──────────────────────────────────────
#
# Permite entrar sin código de verificación. Existe SOLO mientras
# WhatsApp no esté conectado: sin esto no hay forma de entrar a la app.
#
# QUITARLO cuando WhatsApp funcione:
#   PUESTICO_QUICK_ACCESS=0
#
# Con el interruptor en 0, el atajo desaparece del servidor completo,
# no solo el botón: la ruta responde 403 aunque alguien la llame a
# mano. Un atajo de autenticación que se quita escondiendo un botón no
# se quitó.
PUESTICO_QUICK_ACCESS=1

# ─── Código de verificación en pantalla ────────────────────────────
#
# En modo demo el código se muestra en la pantalla para poder probar
# sin proveedor de mensajería. Poner en 0 cuando WhatsApp esté
# conectado, para que el código solo llegue al teléfono.
PUESTICO_DEMO_OTP=1

# ─── Base de datos ─────────────────────────────────────────────────
#
# Por defecto: web/data/puestico.db (SQLite, incluido en Node 22).
# PUESTICO_DB=/ruta/a/puestico.db
