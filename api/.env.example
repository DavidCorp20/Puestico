# ─── Base de datos ───────────────────────────────────
DATABASE_URL=postgresql://carpool:carpool_dev@localhost:5432/carpooling_ve

# ─── Auth ────────────────────────────────────────────
JWT_SECRET=cambiar_en_produccion
JWT_EXPIRES_IN=7d

# ─── Servidor ────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001,https://admin.staging.carpooling.ve

# ─── SMS OTP (proveedor por definir) ─────────────────
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=

# ─── Storage S3-compatible ───────────────────────────
S3_ENDPOINT=
S3_BUCKET=carpooling-ve-docs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ─── Maps ────────────────────────────────────────────
MAPS_PROVIDER=mapbox
MAPS_API_KEY=

# ─── Push (FCM) ──────────────────────────────────────
FCM_SERVER_KEY=

# ─── Negocio ─────────────────────────────────────────
COMMISSION_RATE=0.15
